# AI 成果库 · nginx 反向代理示例
# 用法：把本文件内容并入公司 nginx 主配置，或放到 conf.d/ 下
#       然后按需修改：域名、证书路径、端口、client_max_body_size

upstream ai_tools_backend {
    server 127.0.0.1:8080;      # 后端实际监听地址与端口
    keepalive 16;
}

server {
    listen 80;
    server_name ai.corp.com;     # ← 改成你们的域名

    # 80 端口跳 HTTPS（如公司统一由网关做 TLS，可删掉这段）
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name ai.corp.com;     # ← 改成你们的域名

    ssl_certificate     /etc/nginx/ssl/ai.corp.com.crt;   # ← 改成实际证书路径
    ssl_certificate_key /etc/nginx/ssl/ai.corp.com.key;

    # 附件上传大小上限：必须 ≥ 后端 MAX_UPLOAD_MB（默认 50）
    client_max_body_size 100M;

    # 静态页面不缓存，便于更新后立即生效
    location = / {
        proxy_pass http://ai_tools_backend;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-cache";
    }

    location / {
        proxy_pass         http://ai_tools_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 附件下载：可以交给 nginx 直出，减轻后端压力
    # （需要后端 data/uploads 与 nginx worker 同机同用户，否则去掉这段）
    # location /uploads/ {
    #     alias /data/ai-tools/uploads/;
    #     proxy_set_header Host $host;
    # }
}
