# AI 成果库 · nginx 反向代理示例
# 用法：把本文件内容并入公司 nginx 主配置，或放到 conf.d/ 下
#       然后按需修改：域名、证书路径、端口、client_max_body_size

upstream ai_tools_backend {
    server 127.0.0.1:8080;      # 后端实际监听地址与端口
    keepalive 16;
}

server {
    listen 80;
    server_name ai.corp.com;     # ← 改成你们的域名

    # ────────────────────────────────────────────────────────────
    # 企微「可信域名」所有权校验文件（WW_verify_xxx.txt）
    # 企微保存可信域名时会来取 https://<域名>/WW_verify_xxx.txt，
    # 取不到就报「校验域名所有权不通过」。
    # ★ 这里**不走后端**，nginx 直接读磁盘 → 后端还没部署完也能通过校验，
    #   不用等运维起服务。
    # ★ 文件已随仓库分发（ai-tools-server/web/WW_verify_xxx.txt），
    #   deploy.sh 会自动复制到 /var/www/ai-tools-webroot/，不用手工放。
    # ★ 内容必须是纯文本原样输出，不能是 HTML 页面（企微会判不通过）。
    #   用 root 就是原样吐文件（不加 index、不做二次处理）。
    #
    # ⚠️ 80 端口的跳转必须写在 location / 里，不能写在 server 层：
    #    server 层的 return 在 rewrite 阶段执行，早于 location 匹配，
    #    那这个校验文件的 location 永远轮不到 → 企微取 http 就会拿到 301 跳转。
    location ~ ^/WW_verify_[A-Za-z0-9_-]+\.txt$ {
        root /var/www/ai-tools-webroot;
        default_type text/plain;
        add_header Cache-Control "no-cache";
    }

    # 80 端口跳 HTTPS（如公司统一由网关做 TLS，可删掉这段）
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ai.corp.com;     # ← 改成你们的域名

    ssl_certificate     /etc/nginx/ssl/ai.corp.com.crt;   # ← 改成实际证书路径
    ssl_certificate_key /etc/nginx/ssl/ai.corp.com.key;

    # ────────────────────────────────────────────────────────────
    # 校验文件：443 也要能取到（企微可能先试 https 再试 http）。
    # 同一个文件目录，root 指向同一处 → 放一次两边都生效。
    location ~ ^/WW_verify_[A-Za-z0-9_-]+\.txt$ {
        root /var/www/ai-tools-webroot;
        default_type text/plain;
        add_header Cache-Control "no-cache";
    }

    # 附件上传大小上限：必须 ≥ 后端 MAX_UPLOAD_MB（默认 50）
    client_max_body_size 100M;

    # 静态页面不缓存，便于更新后立即生效
    location = / {
        proxy_pass http://ai_tools_backend;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-cache";
    }

    location / {
        proxy_pass         http://ai_tools_backend;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # 附件下载：可以交给 nginx 直出，减轻后端压力
    # （需要后端 data/uploads 与 nginx worker 同机同用户，否则去掉这段）
    # location /uploads/ {
    #     alias /data/ai-tools/uploads/;
    #     proxy_set_header Host $host;
    # }
}
