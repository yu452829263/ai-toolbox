# 运维在 Linux 服务器上 clone 后直接执行，这里锁死行尾与二进制属性。
# 不加的话：Windows 上编辑过的 .sh 提交后带 CRLF，Linux 上执行报
# "bad interpreter: /bin/bash^M"。

# 默认按文本处理，入库统一 LF
* text=auto eol=lf

# shell / python / js / json 必须 LF
*.sh   text eol=lf
*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.conf text eol=lf
*.example text eol=lf

# 二进制，禁止任何行尾转换与 diff
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
